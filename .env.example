# ==============================================================================
# DIGITAL TWIN - ENVIRONMENT & DATABASE TEMPLATE (.env.example)
# ==============================================================================

PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Atlas Connection URI:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/future_you?retryWrites=true&w=majority

# (Alternative) PostgreSQL / Supabase Connection URI:
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Google Gemini API Key:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
